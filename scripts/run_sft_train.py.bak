"""
SFT 微调 Biomni-A1（以 Qwen2.5-7B-Chat 为例）
输入: data/sft/sft_train.jsonl (ChatML格式)
输出: output/sft_qwen2_7b
"""
import torch
torch.cuda.empty_cache()
import glob, shutil

import os
os.environ["HF_ENDPOINT"] = "https://hf-mirror.com"
from transformers import AutoTokenizer, AutoModelForCausalLM, TrainingArguments, Trainer
from datasets import load_dataset

BASE_MODEL = "Qwen/Qwen1.5-7B-Chat"
OUTPUT_DIR = "output/sft_qwen2_7b"
MAX_LEN = 64

# 加载 ChatML 格式数据
ds = load_dataset("json", data_files="/root/autodl-tmp/Biomni-main/data/sft/sft_train.jsonl")["train"]
tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL, trust_remote_code=True)
tokenizer.padding_side = "right"
tokenizer.pad_token = tokenizer.eos_token

def preprocess(example):
    messages = example["messages"]
    text = ""
    for msg in messages:
        role = msg["role"]
        if role == "system":
            text += f"<|system|>\n{msg['content']}\n"
        elif role == "user":
            text += f"<|user|>\n{msg['content']}\n"
        elif role == "assistant":
            text += f"<|assistant|>\n{msg['content']}\n"
    result = tokenizer(text, truncation=True, padding="max_length", max_length=1024)
    result["labels"] = result["input_ids"]  # 修正此处
    return result

ds = ds.map(preprocess, remove_columns=ds.column_names, batched=False)

model = AutoModelForCausalLM.from_pretrained(BASE_MODEL, torch_dtype="auto", device_map="auto", trust_remote_code=True)

# args = TrainingArguments(
#     per_device_train_batch_size=1,
#     gradient_accumulation_steps=4,
#     num_train_epochs=2,
#     learning_rate=2e-5,
#     bf16=True, # 或 fp16
#     output_dir=OUTPUT_DIR,
#     logging_steps=10,
#     save_strategy="epoch",
#     report_to="none",
# )

# --- 清理旧 checkpoint（训练开始前） ---
for d in glob.glob(os.path.join(OUTPUT_DIR, "checkpoint-*")):
    try:
        shutil.rmtree(d)
        print("Removed old checkpoint:", d)
    except Exception as e:
        print("Failed to remove", d, e)

# --- 简单拆分训练/验证集（如果你已有独立验证集，可直接 load 并赋给 eval_ds） ---
train_test = ds.train_test_split(test_size=0.05, seed=42)
train_ds = train_test["train"]
eval_ds = train_test["test"]

# --- TrainingArguments （注意使用 eval_strategy 而非 evaluation_strategy） ---
args = TrainingArguments(
    per_device_train_batch_size=1,
    gradient_accumulation_steps=4,
    num_train_epochs=2,
    learning_rate=2e-5,
    bf16=True,
    output_dir=OUTPUT_DIR,
    logging_steps=10,
    save_strategy="epoch",     # 或 "steps"
    save_total_limit=1,        # 只保留最近/唯一的 checkpoint（Trainer 会删除旧的）
    eval_strategy="epoch",     # 每个 epoch 评估一次
    load_best_model_at_end=True,
    metric_for_best_model="eval_test_loss",  # <-- 使用实际出现在日志中的 key
    greater_is_better=False,   # 因为是 loss，越小越好
    report_to="none",
)

# Trainer 初始化时传 eval_dataset
trainer = Trainer(
    model=model,
    args=args,
    train_dataset=train_ds,
    eval_dataset=eval_ds,
    # tokenizer=tokenizer,
)

# trainer = Trainer(
#     model=model,
#     args=args,
#     train_dataset=ds,
#     # tokenizer=tokenizer,
# )

trainer.train()
model.save_pretrained(OUTPUT_DIR)
tokenizer.save_pretrained(OUTPUT_DIR)

print("训练完成，准备关机")
os.system("shutdown -h now")
