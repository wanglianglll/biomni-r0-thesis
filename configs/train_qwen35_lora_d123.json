{
  "model": "qwen3.5",
  "peft_method": "lora",
  "use_d123_mixture": true,
  "epochs": 1.0,
  "batch_size": 1,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0001,
  "max_seq_length": 512,
  "test_size": 0.02,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": "auto",
  "torch_dtype": "bf16",
  "bnb_4bit_quant_type": "nf4",
  "bnb_4bit_compute_dtype": "bf16",
  "save_strategy": "epoch",
  "eval_strategy": "epoch",
  "save_total_limit": 1,
  "logging_steps": 20,
  "warmup_ratio": 0.03,
  "weight_decay": 0.0,
  "seed": 42,
  "shutdown_after": false,
  "no_gradient_checkpointing": false,
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",
  "greater_is_better": false
}
